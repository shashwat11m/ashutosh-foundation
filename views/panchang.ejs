<%- include("partials/header") %>

<section class="panchang-page">

  <h1>Today Panchang</h1>
  <p class="panchang-sub"><b>
    <%= panchang.date.toLocaleDateString("en-IN", { weekday: "long", year: "numeric", month: "long", day: "numeric", timeZone: "Asia/Kolkata" }) %>
    </b><br>Panchang for New Delhi, India
  </p>

  <!-- CONTROLS -->
  <form class="panchang-controls" method="GET" action="/panchang">
    <input type="date" name="date" value="<%= dateInputValue %>" onchange="this.form.submit()">

    <div class="panchang-nav">
      <a href="/panchang?date=<%= prevDate %>">&lt;&lt;</a>
      <a class="today-btn" href="/panchang">TODAY</a>
      <a href="/panchang?date=<%= nextDate %>">&gt;&gt;</a>
    </div>
  </form>

  <!-- CARD -->
  <div class="panchang-card">

    <!-- SECTION -->
    <div class="panchang-page-section">
        <h2>Panchang For This Day</h2>

        <div class="panchang-grid">

          <div class="panchang-row">
            <span class="label">Tithi</span>
            <span class="value"><%= panchang.tithi.name %> upto <%= panchang.tithi.endsAt %></span>
          </div>

          <div class="panchang-row">
            <span class="label">Paksha</span>
            <span class="value"><%= panchang.tithi.paksha %></span>
          </div>

          <div class="panchang-row">
            <span class="label">Nakshatra</span>
            <span class="value"><%= panchang.nakshatra.name %> upto <%= panchang.nakshatra.endsAt %></span>
          </div>

          <div class="panchang-row">
            <span class="label">Week Day</span>
            <span class="value"><%= panchang.weekdaySanskrit %></span>
          </div>

          <div class="panchang-row">
            <span class="label">Karana</span>
            <span class="value"><%= panchang.karna.name %> upto <%= panchang.karna.endsAt %></span>
          </div>

          <div class="panchang-row">
            <span class="label">Yoga</span>
            <span class="value"><%= panchang.yoga.name %> upto <%= panchang.yoga.endsAt %></span>
          </div>

        </div>
    </div>

    <div class="panchang-page-section">
        <h2>Sun And Moon Calculations</h2>

        <div class="panchang-grid">

          <div class="panchang-row">
            <span class="label">Sun Rise</span>
            <span class="value"><%= panchang.sunrise %></span>
          </div>

          <div class="panchang-row">
            <span class="label">Sun Set</span>
            <span class="value"><%= panchang.sunset %></span>
          </div>

          <div class="panchang-row">
            <span class="label">Moon Rise</span>
            <span class="value"><%= panchang.moonrise %></span>
          </div>

          <div class="panchang-row">
            <span class="label">Moon Set</span>
            <span class="value"><%= panchang.moonset %></span>
          </div>

          <div class="panchang-row">
            <span class="label">Moon Sign</span>
            <span class="value"><%= panchang.raasi %></span>
          </div>

          <div class="panchang-row">
            <span class="label">Ayanamsa</span>
            <span class="value"><%= panchang.ayanamsa %></span>
          </div>

        </div>
    </div>

    <div class="panchang-page-section">
      <h2>Day Length</h2>

      <div class="panchang-grid">

        <div class="panchang-row">
          <span class="label">Day Duration</span>
          <span class="value"><%= panchang.dayDuration %></span>
        </div>

      </div>
    </div>

    <div class="panchang-page-section">
      <h2>Inauspicious Timings</h2>

      <div class="panchang-grid">

        <div class="panchang-row">
          <span class="label">Rahu Kaal</span>
          <span class="value"><%= panchang.rahuKaal.start %> – <%= panchang.rahuKaal.end %></span>
        </div>

        <div class="panchang-row">
          <span class="label">Yamaganda</span>
          <span class="value coming-soon">Coming soon</span>
        </div>

        <div class="panchang-row">
          <span class="label">Gulika Kaal</span>
          <span class="value coming-soon">Coming soon</span>
        </div>

      </div>
    </div>

    <div class="panchang-page-section">
      <h2>Hindu Month And Year</h2>

      <div class="panchang-grid">

        <div class="panchang-row">
          <span class="label">Vikram Samvat / Month</span>
          <span class="value coming-soon">Coming soon</span>
        </div>

      </div>
    </div>

  </div>

</section>

<%- include("partials/footer") %>
