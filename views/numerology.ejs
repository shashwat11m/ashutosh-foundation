function generateReport() {
  const name = document.getElementById("fullName").value.trim();
  const dd = document.getElementById("dobDD").value.trim();
  const mm = document.getElementById("dobMM").value.trim();
  const yyyy = document.getElementById("dobYYYY").value.trim();
  const system = document.getElementById("numSystem").value;
  const errorBox = document.getElementById("numerologyError");

  /* Validate */
  if (!name) { errorBox.textContent = "Please enter your full name."; errorBox.style.display = "block"; return; }
  if (!dd || !mm || !yyyy) { errorBox.textContent = "Please enter your complete date of birth."; errorBox.style.display = "block"; return; }
  const day = parseInt(dd, 10), month = parseInt(mm, 10), year = parseInt(yyyy, 10);
  if (isNaN(day) || isNaN(month) || isNaN(year) || day < 1 || day > 31 || month < 1 || month > 12 || year < 1000) {
    errorBox.textContent = "Please enter a valid date of birth (DD/MM/YYYY)."; errorBox.style.display = "block"; return;
  }
  errorBox.style.display = "none";

  /* Calculate */
  const radical = calcRadicalNumber(dd);
  const destiny = calcDestinyNumber(dd, mm, yyyy, system);
  const nameNum = calcNameNumber(name, system);

  const radicalNum = radical.final;
  const destinyNum = destiny.reduction.final;
  const nameNumber = nameNum.reduction.final;

  const hasMaster = (radicalNum === 11 || radicalNum === 22 || destinyNum === 11 || destinyNum === 22 || nameNumber === 11 || nameNumber === 22);
  const masterNumber = radicalNum === 11 || radicalNum === 22 ? radicalNum : destinyNum === 11 || destinyNum === 22 ? destinyNum : nameNumber === 11 || nameNumber === 22 ? nameNumber : null;

  /* Populate Report */
  document.getElementById("reportName").textContent = name;
  document.getElementById("reportDOB").textContent = dd + "/" + mm + "/" + yyyy;
  document.getElementById("reportSystem").textContent = system.charAt(0).toUpperCase() + system.slice(1) + " Numerology";

  /* Main number cards */
  document.getElementById("radicalValue").textContent = radicalNum;
  document.getElementById("radicalTitle").textContent = numberTitles[radicalNum] || "";
  document.getElementById("destinyValue").textContent = destinyNum;
  document.getElementById("destinyTitle").textContent = numberTitles[destinyNum] || "";
  document.getElementById("nameValue").textContent = nameNumber;
  document.getElementById("nameTitle").textContent = numberTitles[nameNumber] || "";

  /* Card colours */
  const cardColours = { 1:"#fff3e0", 2:"#e8eaf6", 3:"#fff8e1", 4:"#e0f2f1", 5:"#e8f5e9", 6:"#fce4ec", 7:"#f3e5f5", 8:"#ebebeb", 9:"#fbe9e7", 11:"#ede7f6", 22:"#efebe9" };
  document.getElementById("cardRadical").style.background = cardColours[radicalNum] || "#f5f5f5";
  document.getElementById("cardDestiny").style.background = cardColours[destinyNum] || "#f5f5f5";
  document.getElementById("cardName").style.background = cardColours[nameNumber] || "#f5f5f5";

  /* Favourable Information */
  const fav = favourableData[radicalNum] || favourableData[1];
  const favGrid = document.getElementById("favourableGrid");
  const favItems = [
    { icon:"fa-star", label:"Favourable Sign", value: fav.sign },
    { icon:"fa-font", label:"Favourable Alphabets", value: fav.alphabets },
    { icon:"fa-gem", label:"Gemstone", value: fav.gemstone },
    { icon:"fa-calendar-day", label:"Favourable Day(s)", value: fav.days },
    { icon:"fa-hashtag", label:"Favourable Number(s)", value: fav.numbers },
    { icon:"fa-compass", label:"Direction", value: fav.direction },
    { icon:"fa-palette", label:"Auspicious Colour(s)", value: fav.colour },
    { icon:"fa-globe", label:"Ruling Planet", value: fav.planet },
    { icon:"fa-pray", label:"God / Goddess", value: fav.god },
    { icon:"fa-utensils", label:"Fast", value: fav.fast },
    { icon:"fa-calendar-check", label:"Favourable Date(s)", value: fav.dates },
    { icon:"fa-audio-description", label:"Mantra", value: fav.mantra }
  ];
  favGrid.innerHTML = favItems.map(item => `
    <div class="fav-card">
      <div class="fav-icon"><i class="fas ${item.icon}"></i></div>
      <div class="fav-label">${item.label}</div>
      <div class="fav-value">${item.value}</div>
    </div>
  `).join("");

  /* Radical Interpretation */
  const radData = interpretations.radical[radicalNum] || interpretations.radical[1];
  document.getElementById("radicalSectionTitle").textContent = `Number ${radicalNum} — ${numberTitles[radicalNum]}`;
  document.getElementById("radicalInterpretation").innerHTML = buildInterpretationHTML(radData, [
    ["Personality", "personality"], ["Character", "character"], ["Strengths", "strengths"],
    ["Weaknesses", "weaknesses"], ["Behaviour", "behaviour"], ["Relationships", "relationships"], ["General Tendencies", "general"]
  ]);

  /* Destiny Interpretation */
  const destData = interpretations.destiny[destinyNum] || interpretations.destiny[1];
  document.getElementById("destinySectionTitle").textContent = `Number ${destinyNum} — ${numberTitles[destinyNum]}`;
  document.getElementById("destinyInterpretation").innerHTML = buildInterpretationHTML(destData, [
    ["Life Direction", "lifeDirection"], ["Personality Tendencies", "personality"], ["Strengths", "strengths"],
    ["Challenges", "challenges"], ["Career Tendencies", "career"], ["Financial Tendencies", "financial"], ["Relationships", "relationships"]
  ]);

  /* Name Interpretation */
  const nameData = interpretations.nameNum[nameNumber] || interpretations.nameNum[1];
  document.getElementById("nameSectionTitle").textContent = `Number ${nameNumber} — ${numberTitles[nameNumber]}`;
  document.getElementById("nameInterpretation").innerHTML = `
    <div class="interp-name-display">
      <div class="interp-name-text"><i class="fas fa-user"></i> ${name}</div>
      <div class="interp-name-number">Name Number: <strong>${nameNumber}</strong></div>
    </div>
    ${buildInterpretationHTML(nameData, [
      ["Natural Talents", "naturalTalents"], ["Personality", "personality"], ["Attitudes", "attitudes"],
      ["Strengths", "strengths"], ["Challenges", "challenges"], ["Potential", "potential"]
    ])}
  `;

  /* Master Number Section */
  if (masterNumber && interpretations.radical[masterNumber]) {
    document.getElementById("masterSection").style.display = "block";
    document.getElementById("masterTitle").textContent = `Number ${masterNumber} — ${numberTitles[masterNumber]}`;
    const mData = interpretations.radical[masterNumber];
    document.getElementById("masterInterpretation").innerHTML = `
      <div class="master-notice"><i class="fas fa-crown"></i> You carry Master Number ${masterNumber} — a rare and powerful vibration found in only about 4% of the population. This number amplifies all associated energies and brings heightened spiritual awareness and responsibility.</div>
      ${buildInterpretationHTML(mData, [
        ["Spiritual Significance", "personality"], ["Core Character", "character"], ["Extraordinary Strengths", "strengths"],
        ["Challenges of Mastery", "weaknesses"], ["Life Expression", "behaviour"], ["Soul Connections", "relationships"], ["Your Master Purpose", "general"]
      ])}
    `;
  } else {
    document.getElementById("masterSection").style.display = "none";
  }

  /* Auspicious Place */
  document.getElementById("auspiciousPlace").innerHTML = `
    <div class="interp-block"><h4><i class="fas fa-location-arrow"></i> Directions &amp; Locations</h4>
    <p>Based on your Radical Number ${radicalNum}, your most auspicious direction is <strong>${fav.direction}</strong>. When making important decisions, travelling, or setting up your workspace, try to face or position yourself toward this direction.</p>
    <p>You tend to thrive in locations that resonate with your ruling planet <strong>${fav.planet}</strong>. ${radicalNum === 1 ? "East-facing cities and places associated with the Sun — warm, bright, and authoritative environments — favour you." : radicalNum === 2 ? "North-West regions, places near water, and moonlit environments have a calming and positive effect on you." : radicalNum === 3 ? "North-East regions, places of learning and spiritual significance, and Jupiter-ruled areas of expansion and abundance favour you." : radicalNum === 4 ? "South-East regions and places associated with technology, innovation, and structured development favour you." : radicalNum === 5 ? "Northern regions, places of movement and change, and Mercury-ruled urban environments suit your dynamic nature." : radicalNum === 6 ? "South-East and South-West regions, places of beauty and culture, and Venus-ruled luxurious environments favour you." : radicalNum === 7 ? "South-West regions, places of spiritual significance, and quiet, contemplative environments suit your introspective nature." : radicalNum === 8 ? "Western regions and Saturn-ruled industrial or organisational environments favour your ambitious nature." : radicalNum === 9 ? "Southern regions and Mars-ruled environments of action and passion favour your humanitarian spirit." : "Your direction brings heightened spiritual awareness and alignment with your life mission."}</p>
    <p><strong>Avoid:</strong> Position yourself away from your unfavourable directions when possible, especially during important events or decisions.</p></div>
  `;

  /* Health */
  document.getElementById("healthSection").innerHTML = `<div class="interp-block"><p>${sectionData.health[radicalNum] || sectionData.health[1]}</p>
    <p class="health-note"><i class="fas fa-info-circle"></i> <strong>Note:</strong> These insights are based on numerological tendencies. Always consult a qualified healthcare professional for medical advice.</p></div>`;

  /* Auspicious Time */
  const favHours = { 1:"5:00 AM – 7:00 AM (Sunrise hour)", 2:"6:00 PM – 8:00 PM (Moonrise)", 3:"6:00 AM – 8:00 AM (Jupiter hour)", 4:"2:00 PM – 4:00 PM (Rahu kaal, use cautiously)", 5:"10:00 AM – 12:00 PM (Mercury hour)", 6:"6:00 AM – 8:00 PM (Venus evening hour)", 7:"8:00 PM – 10:00 PM (Ketu hour)", 8:"3:00 PM – 5:00 PM (Saturn hour)", 9:"12:00 PM – 2:00 PM (Mars midday)", 11:"4:00 AM – 6:00 AM (Brahma muhurta)", 22:"4:00 AM – 6:00 AM (Brahma muhurta)" };
  document.getElementById("auspiciousTime").innerHTML = `<div class="interp-block"><h4><i class="fas fa-clock"></i> Your Auspicious Hours</h4>
    <p>Your most favourable time of day is <strong>${favHours[radicalNum] || favHours[1]}</strong>. This is when your personal energy is at its peak and important decisions or actions are most likely to succeed.</p>
    <p><strong>${radicalNum <= 2 ? "Early morning" : radicalNum <= 4 ? "Morning to midday" : radicalNum <= 6 ? "Midday to afternoon" : "Evening"}</strong> hours are generally most productive for you. ${radicalNum === 1 ? "The sunrise hour is especially powerful for new beginnings." : radicalNum === 7 ? "Night-time solitude is when your intuition is strongest." : radicalNum === 8 ? "The Saturn hours demand discipline — use this time for serious work." : "Use this time for important tasks and spiritual practices."}</p>
    <p><strong>Days that favour important events:</strong> ${fav.days}. Whenever possible, schedule significant activities on your favourable days.</p></div>`;

  /* Career */
  document.getElementById("careerSection").innerHTML = `<div class="interp-block"><p>${sectionData.career[radicalNum] || sectionData.career[1]}</p>
    <p><strong>Fields to avoid:</strong> ${radicalNum === 1 ? "Highly bureaucratic environments where you have no autonomy." : radicalNum === 2 ? "Highly competitive, aggressive, or solitary work environments." : radicalNum === 3 ? "Repetitive, detail-only work with no creative outlet." : radicalNum === 4 ? "Highly chaotic, unstructured, or constantly changing environments." : radicalNum === 5 ? "Rigid, monotonous jobs with no variety or travel." : radicalNum === 6 ? "Cut-throat competitive environments that disregard people." : radicalNum === 7 ? "Highly social, superficial, or noisy work environments." : radicalNum === 8 ? "Low-impact, underpaid roles that don't match your ambition." : "Environments that suppress your compassion and idealism."}</p></div>`;

  /* Remedies */
  document.getElementById("remediesSection").innerHTML = `<div class="interp-block">${sectionData.remedies[radicalNum] || sectionData.remedies[1]}</div>`;

  /* Yantra */
  document.getElementById("yantraSection").innerHTML = `<div class="interp-block">${sectionData.yantra[radicalNum] || sectionData.yantra[1]}</div>`;

  /* Exclusive Facts */
  document.getElementById("factsSection").innerHTML = `<div class="interp-block">${sectionData.facts[radicalNum] || sectionData.facts[1]}</div>`;

  /* Show report, hide calculator */
  document.getElementById("calcSection").style.display = "none";
  document.getElementById("reportSection").style.display = "block";
  window.scrollTo({ top: 0, behavior: "smooth" });
}

function buildInterpretationHTML(data, fields) {
  return fields.map(([label, key]) => {
    if (!data[key]) return "";
    return `<div class="interp-field"><h4>${label}</h4><p>${data[key]}</p></div>`;
  }).join("");
}

function recalculate() {
  document.getElementById("reportSection").style.display = "none";
  document.getElementById("calcSection").style.display = "block";
  window.scrollTo({ top: 0, behavior: "smooth" });
}

