/* ---------- LETTER-TO-NUMBER MAPS ---------- */
const maps = {
  chaldean: { A:1,I:1,J:1,Q:1,Y:1, B:2,K:2,R:2, C:3,G:3,L:3,S:3, D:4,M:4,T:4, E:5,H:5,N:5,X:5, U:6,V:6,W:6, O:7,Z:7, F:8,P:8 },
  pythagorean: { A:1,J:1,S:1, B:2,K:2,T:2, C:3,L:3,U:3, D:4,M:4,V:4, E:5,N:5,W:5, F:6,O:6,X:6, G:7,P:7,Y:7, H:8,Q:8,Z:8, I:9,R:9 },
  sepherial: { A:1,J:1,S:1, B:2,K:2,T:2, C:3,L:3,U:3, D:4,M:4,V:4, E:5,N:5,W:5, F:6,O:6,X:6, G:7,P:7,Y:7, H:8,Q:8,Z:8, I:9,R:9 },
  modern: { A:1,J:1,S:1, B:2,K:2,T:2, C:3,L:3,U:3, D:4,M:4,V:4, E:5,N:5,W:5, F:6,O:6,X:6, G:7,P:7,Y:7, H:8,Q:8,Z:8, I:9,R:9 }
};

/* ---------- REDUCTION HELPERS ---------- */
function reduceSingle(num, keepMaster) {
  const steps = [num];
  let n = num;
  while (n > 9) {
    if (keepMaster && (n === 11 || n === 22)) break;
    n = String(n).split("").reduce((s, d) => s + parseInt(d, 10), 0);
    steps.push(n);
  }
  return { final: n, steps };
}

function reduceDatePart(part, keepMaster) {
  return reduceSingle(part, keepMaster);
}

/* ---------- CALCULATION FUNCTIONS ---------- */
function calcNameNumber(name, system) {
  const m = maps[system];
  const letters = [];
  let total = 0;
  name.toUpperCase().split("").forEach(ch => {
    if (m[ch]) { letters.push({ letter: ch, value: m[ch] }); total += m[ch]; }
  });
  const keepMaster = (system === "sepherial" || system === "modern");
  const reduction = reduceSingle(total, keepMaster);
  return { letters, total, reduction };
}

function calcRadicalNumber(day) {
  const d = parseInt(day, 10);
  return reduceSingle(d, true);
}

function calcDestinyNumber(day, month, year, system) {
  const keepMaster = (system === "sepherial" || system === "modern");
  const d = reduceDatePart(parseInt(day, 10), keepMaster);
  const m = reduceDatePart(parseInt(month, 10), keepMaster);
  const y = reduceDatePart(parseInt(year, 10), keepMaster);
  const subTotal = d.final + m.final + y.final;
  const steps = [...d.steps, " + ", ...m.steps, " + ", ...y.steps, " = ", subTotal];
  const reduction = reduceSingle(subTotal, keepMaster);
  return { dayPart: d, monthPart: m, yearPart: y, subTotal, steps, reduction };
}

