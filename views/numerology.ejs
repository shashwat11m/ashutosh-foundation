<!-- numerology.ejs — Personalised Numerology Report -->
<%- include("partials/header") %>

<div class="numerology-page">

  <!-- ============ INPUT SECTION ============ -->
  <section id="calcSection">
    <div class="numerology-hero">
      <div class="numerology-hero-icon"><i class="fas fa-star-of-david"></i></div>
      <h1>Numerology Report</h1>
      <p>Discover the hidden power of your name and birth date. Select your preferred numerology system and receive a comprehensive, personalised reading.</p>
    </div>

    <div class="numerology-calc">
      <h2>Calculate Your Numbers</h2>
      <p class="numerology-calc-subtitle">Enter your details below to generate your complete numerology report.</p>

      <form id="numerologyForm" class="numerology-form" onsubmit="return false;">
        <div class="numerology-field">
          <label for="fullName">Full Name <span class="required">*</span>
            <span class="field-hint">As it appears on your birth certificate</span>
          </label>
          <input type="text" id="fullName" placeholder="e.g. Ashutosh Mishra" required>
        </div>

        <div class="numerology-field">
          <label for="dob">Date of Birth <span class="required">*</span>
            <span class="field-hint">Format: DD / MM / YYYY</span>
          </label>
          <div class="dob-inputs">
            <input type="text" id="dobDD" maxlength="2" placeholder="DD" inputmode="numeric" required>
            <span class="dob-sep">/</span>
            <input type="text" id="dobMM" maxlength="2" placeholder="MM" inputmode="numeric" required>
            <span class="dob-sep">/</span>
            <input type="text" id="dobYYYY" maxlength="4" placeholder="YYYY" inputmode="numeric" required>
          </div>
        </div>

        <div class="numerology-field">
          <label for="numSystem">Numerology Type</label>
          <div class="select-wrap">
            <select id="numSystem">
              <option value="chaldean" selected>Chaldean</option>
              <option value="sepherial">Sepherial</option>
              <option value="modern">Modern</option>
              <option value="pythagorean">Pythagorean</option>
            </select>
            <i class="fas fa-chevron-down select-icon"></i>
          </div>
        </div>

        <div class="numerology-form-actions">
          <a href="#" class="btn chat-btn" onclick="generateReport()"><i class="fas fa-calculator"></i> Generate My Report</a>
        </div>
        <div class="numerology-error" id="numerologyError"></div>
      </form>
    </div>
  </section>

  <!-- ============ REPORT SECTION (hidden until calculated) ============ -->
  <section id="reportSection" style="display:none;">

    <!-- Report Header -->
    <div class="report-header">
      <div class="report-header-icon"><i class="fas fa-star-of-david"></i></div>
      <h1>Your Numerology Report</h1>
      <div class="report-personal-info">
        <span><i class="fas fa-user"></i> <span id="reportName"></span></span>
        <span><i class="fas fa-calendar-alt"></i> <span id="reportDOB"></span></span>
        <span><i class="fas fa-book-open"></i> <span id="reportSystem"></span></span>
      </div>
    </div>

    <!-- Three Main Numbers -->
