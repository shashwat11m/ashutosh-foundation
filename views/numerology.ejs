      <div class="main-number-card" id="cardRadical">
        <div class="main-number-glow"></div>
        <div class="main-number-value" id="radicalValue"></div>
        <div class="main-number-label">Radical Number</div>
        <div class="main-number-sublabel" id="radicalTitle"></div>
      </div>
      <div class="main-number-card main-number-featured" id="cardDestiny">
