  const mm = document.getElementById("dobMM");
  const yyyy = document.getElementById("dobYYYY");
  [dd, mm].forEach(el => {
    el.addEventListener("input", function() {
      if (this.value.length === 2) {
        const next = this === dd ? mm : yyyy;
        next.focus();
      }
    });
  });
})();
</script>

