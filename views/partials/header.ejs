<!DOCTYPE html>
<html lang="en">
<head>
  <%
    const SITE_URL = typeof siteUrl !== "undefined" && siteUrl ? siteUrl : "https://astro.ashutoshfoundation.in";
    const m = typeof meta !== "undefined" && meta ? meta : {};

    const pageTitle = m.title || "Ashutosh Foundation | Vedic Astrology, Numerology & Panchang";
    const pageDesc = m.description || "India's trusted platform for Vedic astrology, daily panchang, name numerology, kundli, rashi horoscopes and career counselling by astrologer Ashutosh Mishra.";
    const pageKeywords = m.keywords || "astrology, vedic astrology, numerology, panchang, kundli, horoscope, rashi, career counselling, Ashutosh Foundation";

    let pageImage = m.image || "/images/logo1.png";
    if (!/^https?:\/\//.test(pageImage)) {
      pageImage = SITE_URL + (pageImage.startsWith("/") ? pageImage : "/" + pageImage);
    }

    const pageUrl = m.url || SITE_URL + (typeof currentPath !== "undefined" && currentPath ? currentPath : "/");
    const pageType = m.type || "website";
    const canonical = m.canonical || pageUrl;

    const isNoindex = typeof noindexPage !== "undefined" ? noindexPage
      : (m.robots === "noindex, nofollow");
    const robots = m.robots || (isNoindex ? "noindex, nofollow" : "index, follow");
  %>

  <meta charset="UTF-8">
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>">
  <meta name="keywords" content="<%= pageKeywords %>">
  <meta name="robots" content="<%= robots %>">
  <meta name="author" content="Ashutosh Mishra">
  <meta name="theme-color" content="#f5b301">
  <link rel="canonical" href="<%= canonical %>">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <link rel="icon" href="/images/logo-100.png" type="image/png">
  <link rel="apple-touch-icon" href="/images/logo.png">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Open Graph -->
  <meta property="og:type" content="<%= pageType %>">
  <meta property="og:site_name" content="Ashutosh Foundation">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= pageDesc %>">
  <meta property="og:image" content="<%= pageImage %>">
  <meta property="og:url" content="<%= pageUrl %>">
  <meta property="og:locale" content="en_IN">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= pageTitle %>">
  <meta name="twitter:description" content="<%= pageDesc %>">
  <meta name="twitter:image" content="<%= pageImage %>">

  <% if (typeof article !== "undefined" && article && article.date) { %>
    <meta property="article:published_time" content="<%= new Date(article.date).toISOString() %>">
  <% } %>

  <!-- Structured Data: Organization / WebSite -->
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Ashutosh Foundation",
    "url": SITE_URL,
    "description": "India's trusted platform for Vedic astrology, daily panchang, name numerology, kundli, rashi horoscopes and career counselling.",
    "publisher": {
      "@type": "Organization",
      "name": "Ashutosh Foundation",
      "url": SITE_URL,
      "logo": { "@type": "ImageObject", "url": SITE_URL + "/images/logo.png" }
    }
  }, null, 2) %>
  </script>

  <% if (typeof article !== "undefined" && article) { %>
  <!-- Structured Data: Article -->
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": article.title,
    "description": pageDesc,
    "image": [pageImage],
    "datePublished": article.date ? new Date(article.date).toISOString() : null,
    "dateModified": article.date ? new Date(article.date).toISOString() : null,
    "author": { "@type": "Person", "name": "Ashutosh Mishra" },
    "publisher": {
      "@type": "Organization",
      "name": "Ashutosh Foundation",
      "logo": { "@type": "ImageObject", "url": SITE_URL + "/images/logo.png" }
    },
    "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl }
  }, null, 2) %>
  </script>
  <% } %>

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/numerology.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>

<!-- Top Bar (Rashis) -->
<div class="topbar">
  <% const rashis = ["Aries","Taurus","Gemini","Cancer","Leo","Virgo","Libra","Scorpio","Sagittarius","Capricorn","Aquarius","Pisces"]; %>
  <% rashis.forEach(r => { %>
    <a href="/rashi/<%= r %>"><%= r %></a>
  <% }) %>
</div>

<!-- Navbar -->
<div class="navbar">
  <div class="logo"><a href="/"><img src="/images/logo115h.png"></a></div>

  <div class="menu-toggle" onclick="toggleMenu()">
    <i class="fas fa-bars"></i>
  </div>

  <div class="nav-links" id="navLinks">
    <a href="/">Home</a>
    <a href="/articles">Articles</a>
    <a href="/panchang">Panchang</a>
    <a href="/numerology">Numerology</a>
    <a href="#">Astrology</a>
    <a href="#">2026</a>
    <!-- <a href="#">Compatibility</a>
    <a href="#">Horoscope</a>
    <a href="#">Calculators</a> -->
  </div>

  <div class="nav-buttons">
    <% if (typeof sessionUser !== "undefined" && sessionUser) { %>
      <% if (sessionUser.role === "admin") { %>
        <a class="btn chat-btn" href="/admin">Admin Panel</a>
      <% } else { %>
        <a class="btn chat-btn" href="/dashboard">Dashboard</a>
      <% } %>
      <a class="btn call-btn" href="/logout">Logout</a>
    <% } else { %>
      <a class="btn chat-btn" href="/login">Login</a>
      <a class="btn call-btn" href="/signup">Sign Up</a>
    <% } %>
  </div>
</div>

<script>
function toggleMenu() {
  document.getElementById("navLinks").classList.toggle("active");
}
</script>
