<!DOCTYPE html>
<html>
<head>
  <title>Ashutosh Foundation</title>

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/numerology.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>

<!-- Top Bar (Rashis) -->
<div class="topbar">
  <% const rashis = ["Aries","Taurus","Gemini","Cancer","Leo","Virgo","Libra","Scorpio","Sagittarius","Capricorn","Aquarius","Pisces"]; %>
  <% rashis.forEach(r => { %>
    <a href="/rashi/<%= r %>"><%= r %></a>
  <% }) %>
</div>

<!-- Navbar -->
<div class="navbar">
  <div class="logo"><a href="/"><img src="/images/logo115h.png"></a></div>

  <div class="menu-toggle" onclick="toggleMenu()">
    <i class="fas fa-bars"></i>
  </div>

  <div class="nav-links" id="navLinks">
    <a href="/">Home</a>
    <a href="/articles">Articles</a>
    <a href="/panchang">Panchang</a>
    <a href="/numerology">Numerology</a>
    <a href="#">Astrology</a>
    <a href="#">2026</a>
    <!-- <a href="#">Compatibility</a>
    <a href="#">Horoscope</a>
    <a href="#">Calculators</a> -->
  </div>

  <div class="nav-buttons">
    <% if (typeof sessionUser !== "undefined" && sessionUser) { %>
      <% if (sessionUser.role === "admin") { %>
        <a class="btn chat-btn" href="/admin">Admin Panel</a>
      <% } else { %>
        <a class="btn chat-btn" href="/dashboard">Dashboard</a>
      <% } %>
      <a class="btn call-btn" href="/logout">Logout</a>
    <% } else { %>
      <a class="btn chat-btn" href="/login">Login</a>
      <a class="btn call-btn" href="/signup">Sign Up</a>
    <% } %>
  </div>
</div>

<script>
function toggleMenu() {
  document.getElementById("navLinks").classList.toggle("active");
}
</script>
