<%- include("partials/header") %>
<section><div class="auth-box"><h2>Buy Questions</h2><p class="auth-subtitle">You currently have <strong><%= user.questionsLeft %></strong> question(s) left.</p><% if (error) { %><div class="alert-error"><%= error %></div><% } %><form action="/dashboard/buy" method="POST" class="admin-form auth-form"><label class="form-label">Choose a pack</label><div class="plan-options"><% Object.entries(plans).forEach(([quantity, price], index) => { %><label class="plan-option"><input type="radio" name="quantity" value="<%= quantity %>" <%= index === 0 ? "checked" : "" %>><span><strong><%= quantity %> Questions</strong><small>₹<%= price %></small></span></label><% }) %></div><label for="phone" class="form-label">Mobile number (for payment confirmation)</label><input type="tel" name="phone" id="phone" placeholder="10-digit mobile number" value="<%= user.phone || '' %>" pattern="[6-9][0-9]{9}" required><button class="btn chat-btn">Continue to Payment</button></form><p class="auth-switch"><a href="/dashboard">&larr; Back to dashboard</a></p></div></section>
<%- include("partials/footer") %>
