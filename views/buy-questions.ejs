<%- include("partials/header") %>
<section><div class="auth-box"><h2>Buy Questions</h2><p class="auth-subtitle">You currently have <strong><%= user.questionsLeft %></strong> question(s) left.</p>
<p class="offer-banner">🔥 Limited time offer! Get more questions for the same price!</p>
<% if (error) { %><div class="alert-error"><%= error %></div><% } %>
<form action="/dashboard/buy" method="POST" class="admin-form auth-form"><label class="form-label">Choose a pack</label><div class="plan-options"><% Object.entries(plans).forEach(([quantity, plan], index) => { %><label class="plan-option"><input type="radio" name="quantity" value="<%= quantity %>" <%= index === 0 ? "checked" : "" %>><span><span class="offer-tag">OFFER</span><strong><s class="plan-was-qty"><%= plan.wasQty %> Questions</s><br><%= quantity %> Questions</strong><small>₹<%= plan.price %></small></span></label><% }) %></div>
<p class="offer-fineprint">Offer valid for a limited time only.</p>
<label for="phone" class="form-label">Mobile number (for payment confirmation)</label><input type="tel" name="phone" id="phone" placeholder="10-digit mobile number" value="<%= user.phone || '' %>" pattern="[6-9][0-9]{9}" required><button class="btn chat-btn">Continue to Payment</button></form><p class="auth-switch"><a href="/dashboard">&larr; Back to dashboard</a></p>
<p class="support-note">Facing an issue with a payment? Email <a href="mailto:ashutoshfndn@gmail.com">ashutoshfndn@gmail.com</a>.</p>
</div></section>
<%- include("partials/footer") %>
