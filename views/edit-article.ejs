<%- include("partials/header") %>
<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

<section class="admin-page">

  <h2>Edit Article ✏️</h2>

<form action="/admin/edit/<%= article._id %>" method="POST" enctype="multipart/form-data" class="admin-form">

  <input type="text" name="title" value="<%= article.title %>" required>

  <div id="editor"><%- article.content %></div>
    <input type="hidden" name="content" id="content">

  <% if(article.image){ %>
    <img src="/uploads/<%= article.image %>" width="150">
  <% } %>

  <input type="file" name="image" accept="image/*">

  <button class="btn call-btn">Update</button>

</form>

</section>


<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

<script>
var quill = new Quill('#editor', {
  theme: 'snow',
  placeholder: 'Write your article...',
  modules: {
    toolbar: [
      [{ header: [1, 2, 3, false] }],
      ['bold', 'italic', 'underline'],
      ['link', 'image'],
      [{ list: 'ordered' }, { list: 'bullet' }]
    ]
  }
});

// save HTML
document.querySelector("form").onsubmit = function() {
  document.querySelector("#content").value = quill.root.innerHTML;
};
</script>
<%- include("partials/footer") %>