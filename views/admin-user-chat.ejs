<%- include("partials/header") %>
<section class="admin-page"><a href="/admin/queries" class="back-link">← Back to question inbox</a><div class="admin-chat-head"><div><h2><%= user.name %></h2><p class="query-meta-sub"><%= user.email %> · <%= user.questionsLeft %> questions left</p></div><details class="details-panel"><summary class="btn">Show birth details</summary><% if (user.birthProfiles.length) { %><ul class="profile-list"><% user.birthProfiles.forEach(p => { %><li><strong><%= p.label %></strong><br><%= new Date(p.dateOfBirth).toLocaleDateString() %>, <%= p.timeOfBirth %><br><%= p.placeOfBirth %></li><% }) %></ul><% } else { %><p class="empty-note">No saved birth details.</p><% } %></details></div><div class="admin-chat-window"><% questions.forEach(q => { const primary=user.birthProfiles.id(q.birthProfile); const secondary=q.secondBirthProfile && user.birthProfiles.id(q.secondBirthProfile); %><div class="chat-bubble chat-question"><p><%= q.questionText %></p><span class="chat-person">For: <%= primary ? primary.label : "Saved profile" %><%= secondary ? " & " + secondary.label : "" %></span><span class="chat-time"><%= new Date(q.createdAt).toLocaleString() %></span></div><% if (q.status === "answered") { %><div class="chat-bubble chat-answer"><p><%= q.answerText %></p><span class="chat-time">Answered <%= new Date(q.answeredAt).toLocaleString() %></span></div><% } else { %><form action="/admin/queries/<%= q._id %>/answer" method="POST" class="admin-answer-form"><input type="hidden" name="userId" value="<%= user._id %>"><textarea name="answerText" placeholder="Write your answer..." required></textarea><button class="btn chat-btn">Send answer</button></form><% } %><% }) %></div><details class="recommendation-editor"><summary class="btn">Edit remedies & gemstones</summary><form action="/admin/users/<%= user._id %>/recommendations" method="POST" class="admin-form"><label>Suggested remedies (one per line)</label><textarea name="suggestedRemedies" placeholder="Enter a remedy"><%= (user.suggestedRemedies || []).join('\n') %></textarea><label>Suggested gemstones (one per line)</label><textarea name="suggestedGemstones" placeholder="Enter a gemstone"><%= (user.suggestedGemstones || []).join('\n') %></textarea><button class="btn chat-btn">Save suggestions</button></form></details></section>
<%- include("partials/footer") %>
