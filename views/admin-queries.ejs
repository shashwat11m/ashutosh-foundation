<%- include("partials/header") %>
<section class="admin-page"><h2>Question Inbox</h2><div class="admin-subnav"><a href="/admin" class="btn">Articles</a><a href="/admin/queries" class="btn chat-btn">Queries</a><a href="/admin/users" class="btn">Users</a><a href="/admin/rashis" class="btn">Rashis</a></div><div class="query-columns"><div><h3>Pending users (<%= pendingUsers.length %>)</h3><div class="admin-list"><% if (!pendingUsers.length) { %><p class="empty-note">No pending questions right now.</p><% } %><% pendingUsers.forEach(group => { %><a class="inbox-user-card" href="/admin/queries/user/<%= group.user._id %>"><strong><%= group.user.name %></strong><span><%= group.user.email %></span><small><%= group.count %> pending question(s)</small></a><% }) %></div></div><div><h3>Completed users (<%= answeredUsers.length %>)</h3><div class="admin-list"><% if (!answeredUsers.length) { %><p class="empty-note">No completed conversations yet.</p><% } %><% answeredUsers.forEach(group => { %><a class="inbox-user-card completed" href="/admin/queries/user/<%= group.user._id %>"><strong><%= group.user.name %></strong><span><%= group.user.email %></span><small><%= group.count %> answered question(s)</small></a><% }) %></div></div></div></section>
<%- include("partials/footer") %>
