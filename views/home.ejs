const rashiData = JSON.parse(`<%- JSON.stringify(rashiDataAll) %>`);

function showHoroscope(rashi){

  const data = rashiData[rashi];

  document.getElementById("todayText").innerText = data.today;
  document.getElementById("color").innerText = data.lucky.color;
  document.getElementById("number").innerText = data.lucky.number;
  document.getElementById("mood").innerText = data.lucky.mood;

  document.getElementById("selectedTitle").innerText = rashi.toUpperCase();
  document.getElementById("viewBtn").href = "/rashi/" + rashi;

  // REMOVE ACTIVE
  document.querySelectorAll(".rashi-btn").forEach(el => el.classList.remove("active"));

  // ADD ACTIVE
  event.currentTarget.classList.add("active");

  const section = document.getElementById("selectedHoroscope");
  section.style.display = "block";
  section.scrollIntoView({ behavior: "smooth" });
}
</script>
<script src="https://maps.googleapis.com/maps/api/js?key=<%= googleMapsApiKey %>&libraries=places"></script>

<script>
const GOOGLE_MAPS_API_KEY = "<%= googleMapsApiKey %>";

function initAutocomplete() {
  const input = document.getElementById("placeInput");

  const autocomplete = new google.maps.places.Autocomplete(input, {
    types: ["(cities)"],
  });

  autocomplete.addListener("place_changed", () => {
    const place = autocomplete.getPlace();

    if (!place.geometry) return;

    const lat = place.geometry.location.lat();
    const lng = place.geometry.location.lng();

    document.getElementById("latitude").value = lat;
    document.getElementById("longitude").value = lng;

    // timezone
    fetch(`https://maps.googleapis.com/maps/api/timezone/json?location=${lat},${lng}&timestamp=${Math.floor(Date.now()/1000)}&key=${GOOGLE_MAPS_API_KEY}`)
    .then(res => res.json())
    .then(data => {
      document.getElementById("timezone").value = data.rawOffset / 3600;
    });
  });
}

window.onload = initAutocomplete;
</script>

<script>
async function submitGetKundali() {

  document.getElementById("loader").style.display = "block";

  const name = document.querySelector("[name='name']").value;
  const dob = document.querySelector("[name='dob']").value;
  const tob = document.querySelector("[name='tob']").value;
  const phone = document.querySelector("[name='phone']").value;
  const placeOfBirth = document.getElementById("placeInput").value;

  const lat = document.getElementById("latitude").value;
  const lon = document.getElementById("longitude").value;
  const tz = document.getElementById("timezone").value;

  const res = await fetch("/api/kundli", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({ name, dob, tob, lat, lon, tz, phone, placeOfBirth })
  });

  const data = await res.json();

  document.getElementById("loader").style.display = "none";

  renderKundli(data, name);
}
function renderKundli(data, name){

  const planet = data.planet?.response || {};
  const sade = data.sade?.response || {};
  const dasha = data.mahadasha?.response || {};
  const panchang = planet.panchang || {};

  document.getElementById("kundliResult").innerHTML = `

  <div class="kundli-container">

    <h2>${name}'s Kundli Report</h2>

    <!-- ================= CHARTS ================= -->
    <div class="kundli-card">

      <div class="chart-row">

        <div class="chart-item">
          <div class="chart-box">${data.d1 || ""}</div>
          <div class="chart-label">D1 Chart (Birth Chart)</div>
        </div>

        <div class="chart-item">
          <div class="chart-box">${data.d9 || ""}</div>
          <div class="chart-label">D9 Chart (Navamsha)</div>
        </div>

      </div>

    </div>

    <!-- ================= PLANETS ================= -->
    <div class="kundli-card">
      <h3>Planet Details</h3>

      <div class="table-scroll">
      <table class="planet-table">
        <thead>
          <tr>
            <th>Planet</th>
            <th>Sign</th>
            <th>Nakshatra</th>
            <th>House</th>
            <th>Avastha</th>
          </tr>
        </thead>

        <tbody>
        ${
          Object.values(planet)
            .filter(p => p?.full_name)
            .map(p => `
              <tr>
                <td>${p.full_name}</td>
                <td>${p.zodiac}</td>
                <td>${p.nakshatra}</td>
                <td>${p.house}</td>
                <td>${p.basic_avastha}</td>
              </tr>
            `).join("")
        }
        </tbody>
      </table>
      </div>
    </div>

    <!-- ================= BASIC INFO ================= -->
    <div class="kundli-card">
      <h3>Basic Astrology</h3>

      <p><b>Rashi:</b> ${planet.rasi || "-"}</p>
      <p><b>Nakshatra:</b> ${planet.nakshatra || "-"}</p>
    </div>

    <!-- ================= LUCKY ================= -->
    <div class="kundli-card">
      <h3>Lucky Details</h3>

      <p><b>Gem:</b> ${planet.lucky_gem?.join(", ") || "-"}</p>
      <p><b>Numbers:</b> ${planet.lucky_num?.join(", ") || "-"}</p>
      <p><b>Colors:</b> ${planet.lucky_colors?.join(", ") || "-"}</p>
      <p><b>Letters:</b> ${planet.lucky_letters?.join(", ") || "-"}</p>
    </div>

    <!-- ================= PANCHANG ================= -->
    <div class="kundli-card">
      <h3>Panchang Details</h3>

      <div class="table-scroll">
      <table class="planet-table">
        <tbody>
          <tr>
            <td><b>Ayanamsa</b></td>
            <td>${panchang.ayanamsa || "-"}</td>
          </tr>
          <tr>
            <td><b>Karana</b></td>
            <td>${panchang.karana || "-"}</td>
          </tr>
          <tr>
            <td><b>Yoga</b></td>
            <td>${panchang.yoga || "-"}</td>
          </tr>
          <tr>
            <td><b>Sunrise</b></td>
            <td>${panchang.sunrise_at_birth || "-"}</td>
          </tr>
          <tr>
            <td><b>Sunset</b></td>
            <td>${panchang.sunset_at_birth || "-"}</td>
          </tr>
          <tr>
            <td><b>Tithi</b></td>
            <td>${panchang.tithi || "-"}</td>
          </tr>
        </tbody>
      </table>
      </div>
    </div>

    <!-- ================= SADE SATI ================= -->
    <div class="kundli-card">
      <h3>Sade Sati</h3>

      <p>${sade.description || "No data available"}</p>

      ${
        sade.remedies
          ? `<ul>${sade.remedies.map(r => `<li>${r}</li>`).join("")}</ul>`
          : ""
      }
    </div>

    <!-- ================= MAHADASHA ================= -->
    <div class="kundli-card">
      <h3>Mahadasha</h3>

      <p><b>Start Year:</b> ${dasha.start_year || "-"}</p>
      <p><b>Dasha Start:</b> ${dasha.dasha_start_date || "-"}</p>

      <div class="table-scroll">
      <table class="planet-table">
        <thead>
          <tr>
            <th>Planet</th>
            <th>Start Date</th>
          </tr>
        </thead>

        <tbody>
        ${
          dasha.mahadasha?.map((p, i) => `
            <tr>
              <td>${p}</td>
              <td>${dasha.mahadasha_order?.[i] || "-"}</td>
            </tr>
          `).join("") || ""
        }
        </tbody>
      </table>
      </div>
    </div>

  </div>
  `;
}
</script>

