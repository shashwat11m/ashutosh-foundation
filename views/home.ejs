<%- include("partials/header") %>
<!-- YELLOW SECTION -->
<div class="section-yellow">
<!-- HERO -->
<section class="hero">
  <div class="hero-content">
    <h1>Discover Your Destiny</h1>
    <p>Talk to India's Trusted Astrologer</p>

    <div class="hero-buttons">
      <a href="https://wa.me/918707718561" class="btn chat-btn">Chat Now</a>
      <a href="tel:+918707718561" class="btn call-btn">Book a Call</a>
    </div>
  </div>
</section>

  <!-- HOROSCOPE WRAPPER -->
  <section class="horoscope-wrapper">

    <!-- LEFT: FORM -->
    <div class="kundali-box">
      <h2>Get Your Free Kundali 📜</h2>

      <form class="kundali-form">
        <input type="text" placeholder="Full Name" required>

        <div class="form-row">
          <input type="date" required>
          <input type="time" required>
        </div>

        <input type="text" placeholder="Place of Birth" required>
        <input type="tel" placeholder="Whatsapp Number" required>

        <button class="btn chat-btn">Get Free Report</button>
      </form>
    </div>

    <!-- RIGHT: PANCHANG -->
    <div class="panchang-box">
      <h2>Today's Panchang 📅</h2>

      <p class="panchang-location">
        New Delhi, India (<%= new Date().toLocaleDateString("en-IN") %>)
      </p>

      <div class="panchang-section">
        <p><b>Tithi:</b> Krishna Saptami upto 21:22:56</p>
        <p><b>Month:</b> Chaitra / Vaisakha</p>
        <p><b>Day:</b> Guruvara | Samvat 2083</p>
      </div>

      <div class="panchang-section">
        <p><b>Nakshatra:</b> Moola upto 08:49:16</p>
        <p><b>Yoga:</b> Parigha upto 17:56:52</p>
      </div>

      <a href="#" class="btn call-btn">Detailed Panchang →</a>
    </div>

  </section>
</div>

<!-- WHITE SECTION (RASHI) -->
<section class="rashi-section">

  <h2>Select Your Rashi 🔮</h2>

  <% const rashis = [
    {name:"aries", symbol:"♈"},
    {name:"taurus", symbol:"♉"},
    {name:"gemini", symbol:"♊"},
    {name:"cancer", symbol:"♋"},
    {name:"leo", symbol:"♌"},
    {name:"virgo", symbol:"♍"},
    {name:"libra", symbol:"♎"},
    {name:"scorpio", symbol:"♏"},
    {name:"sagittarius", symbol:"♐"},
    {name:"capricorn", symbol:"♑"},
    {name:"aquarius", symbol:"♒"},
    {name:"pisces", symbol:"♓"}
  ]; %>

  <div class="rashi-grid-new">
    <% rashis.forEach(r => { %>
      <div class="rashi-btn" onclick="showHoroscope('<%= r.name %>')">
        <div class="symbol"><%= r.symbol %></div>
        <div><%= r.name.toUpperCase() %></div>
      </div>
    <% }) %>
  </div>

</section>

<!-- DYNAMIC HOROSCOPE -->
<section id="selectedHoroscope" class="selected-horoscope" style="display:none;">
  <div class="selected-card">
    <h2 id="selectedTitle"></h2>
    <p id="todayText"></p>

    <div class="lucky-box">
      <span>🎨 <b id="color"></b></span>
      <span>🔢 <b id="number"></b></span>
      <span>😊 <b id="mood"></b></span>
    </div>

    <a id="viewBtn" href="#" class="btn call-btn">View Full Horoscope →</a>
  </div>
</section>

<!-- YELLOW -->
<div class="section-yellow">
  <section class="services">
    <h2>Our Services 🔮</h2>
    <div class="service-grid">
      <div class="card"><h3>Astrology Consultation</h3></div>
      <div class="card"><h3>Love & Marriage</h3></div>
      <div class="card"><h3>Career Guidance</h3></div>
      <div class="card"><h3>Rudraksha</h3></div>
    </div>
  </section>
</div>

<!-- WHITE -->
<section class="articles">
  <h2>Recent Articles 📰</h2>

  <div class="article-grid">
    <% articles.forEach(a => { %>
      <div class="article-card">
        <% if(a.image){ %>
          <img src="/uploads/<%= a.image %>" class="article-img">
        <% } %>
        <h3><%= a.title %></h3>
        <p>
          <%= a.content.replace(/<[^>]*>?/gm,'').substring(0,200) %>...
        </p>
        <a href="/article/<%= a._id %>" class="btn readMore-btn">Read More</a>
      </div>
    <% }) %>
  </div>
</section>

<section class="cta">
  <h2>Talk to Astrologer Now</h2>
  <a href="#" class="btn chat-btn">Chat Instantly</a>
</section>

<script>
const rashiData = JSON.parse(`<%- JSON.stringify(rashiDataAll) %>`);

function showHoroscope(rashi){
  const data = rashiData[rashi];

  document.getElementById("todayText").innerText = data.today;
  document.getElementById("color").innerText = data.lucky.color;
  document.getElementById("number").innerText = data.lucky.number;
  document.getElementById("mood").innerText = data.lucky.mood;

  document.getElementById("selectedTitle").innerText = rashi.toUpperCase();
  document.getElementById("viewBtn").href = "/rashi/" + rashi;

  const section = document.getElementById("selectedHoroscope");
  section.style.display = "block";
  section.scrollIntoView({ behavior: "smooth" });
}
</script>

<%- include("partials/footer") %>